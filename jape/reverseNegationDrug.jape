Imports: {import static gate.Utils.*; }

Phase: reverseNegationDrug
Input: Lookup Lookup3 Token Drug
Options: control=all

//doesn't need Drug for X
// Synth 12 = "She does not need to take her epilim for epilepsy as she has non epileptic seizures."
Rule: reverseNegationDrug
(
{Drug.Negation == Negated}
({Token.string == "for"})[1,3]
({Lookup}):umls
):match
-->
:umls{
umlsAnnots.iterator().next().getFeatures().put("Negation","Negated");
umlsAnnots.iterator().next().getFeatures().put("ruleNegation","reverseNegationDrug");
},
:umls.LookupNegChange = {rule = reverseNegationDrug}