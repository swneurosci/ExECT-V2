Imports: {import static gate.Utils.*; }

Phase: Cleaning
Input:Lookup Frequency Token Drug
Options: control=appelt

Rule: FrequencyCleaned

(
  ({Lookup}):lookup
  ({Token.string == "with"})
  ({Frequency}):freq
  ({!Lookup})
):umls
-->
:freq { 
  inputAS.removeAll(freqAnnots);
},
:umls.FrequencyDeleted = {rule = FrequencyCleaned}


Rule: FrequencyCleaned2

(
  ({Lookup}):lookup
  ({Token.string == "with"})
  ({Frequency}):freq
  ({!Drug})
):umls
-->
:freq { 
  inputAS.removeAll(freqAnnots);
},
:umls.FrequencyDeleted = {rule = FrequencyCleaned2}


Rule: FrequencyCleaned2
// increased Drug

(
  ({Frequency}):freq
  ({Drug})
):umls
-->
:freq { 
  inputAS.removeAll(freqAnnots);
},
:umls.FrequencyDeleted = {rule = FrequencyCleaned2}
