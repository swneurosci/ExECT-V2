Phase: DiagnosisB
Input: DiagnosisA DiagBFiltered Split Lookup Lookup3 Lookup2


// These rules add DiagnosisA when an attribute with another level of certainty follows the diagnosis of epilepsy
// Will need to add context tagger to DiagBFiltered ("focal" but not focal in "focal epilepsy") to get perfect cert and neg
// but this will work for stopping block and most have same negation

Options: control=appelt

Rule: HDiagnosisB1SingleSeizure
Priority: 100

(  
    ({DiagBFiltered}):DiagB
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagnosisA.DiagCategory=="SingleSeizure"}):DiagA 
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB1SingleSeizure, PREF = :DiagB.DiagBFiltered.PREFSeizure,  CUI = :DiagB.DiagBFiltered.CUISeizure,
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}

Rule: HDiagnosisB2SingleSeizure
Priority: 100

(  
    ({DiagnosisA.DiagCategory=="SingleSeizure"}):DiagA
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagBFiltered}):DiagB
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB2SingleSeizure, PREF = :DiagB.DiagBFiltered.PREFSeizure,  CUI = :DiagB.DiagBFiltered.CUISeizure,
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}

Rule: HDiagnosisB1MultipleSeizures
Priority: 100

(  
    ({DiagBFiltered}):DiagB
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagnosisA.DiagCategory=="MultipleSeizures"}):DiagA 
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB1MultipleSeizures, PREF = :DiagB.DiagBFiltered.PREFSeizure,  CUI = :DiagB.DiagBFiltered.CUISeizure,
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}

Rule: HDiagnosisB2MultipleSeizures
Priority: 100

(  
    ({DiagnosisA.DiagCategory=="MultipleSeizures"}):DiagA
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagBFiltered}):DiagB
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB2MultipleSeizures, PREF = :DiagB.DiagBFiltered.PREFSeizure,  CUI = :DiagB.DiagBFiltered.CUISeizure,
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}



Rule: HDiagnosisB1
Priority: 100

(  
    ({DiagBFiltered}):DiagB
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagnosisA, DiagnosisA.DiagCategory!="MultipleSeizures", DiagnosisA.DiagCategory!="SingleSeizure"}):DiagA 
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB1, PREF = :DiagB.DiagBFiltered.PREF, CUI = :DiagB.DiagBFiltered.CUI, 
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}

Rule: HDiagnosisB2
Priority: 100

(  
    ({DiagnosisA, DiagnosisA.DiagCategory!="MultipleSeizures", DiagnosisA.DiagCategory!="SingleSeizure"}):DiagA
    ({Lookup2.minorType == probability})[0,1]:cert
    ({DiagBFiltered}):DiagB
):match  
 -->
:DiagB.DiagnosisB = {rule = HDiagnosisB2, PREF = :DiagB.DiagBFiltered.PREF, CUI = :DiagB.DiagBFiltered.CUI, 
Negation = :DiagA.DiagnosisA.Negation, Certainty = :DiagA.DiagnosisA.Certainty,
Certainty = :cert.Lookup2.Level, DiagCategory = :DiagA.DiagnosisA.DiagCategory}
