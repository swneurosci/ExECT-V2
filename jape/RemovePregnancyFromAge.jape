// To prevent annotating as Age inside phrases 'Her epilepsy started when she was 10 weeks pregnant'

Phase: RemovePregnancyFromAge
Input:  Age Lookup3 Split
Options: control=all


Rule: RemovePregnancyFromAge
(   
    ({Age}):umls
    ({Lookup3.CUI == C0032961}) 
):match
-->
:umls { 
  inputAS.removeAll(umlsAnnots);
},
:umls.RemovePregnancyFromAge = {rule = RemovePregnancyFromAge}



