Phase: YearToMonth
Input: Numeric timePeriod Age Token

/*Token is here to prevent other phrases to be annotated as the rule is very simple*/
Options: control=brill

Rule: YearToMonths1
Priority: 100

(   
    {Numeric.value == 1}
	{timePeriod.time-unit == Year}  
    
 ):match  
 -->
:match.YearToMonths = {rule = YearToMonths1 , value = "12" , timePeriod = "Month"}

// a year
Rule: YearToMonths1b
Priority: 100

(   
    {Token.string == "a"}
	{timePeriod.time-unit == Year}  
    
 ):match  
 -->
:match.YearToMonths = {rule = YearToMonths1b , value = "12" , timePeriod = "Month"}


Rule: YearToMonths2
