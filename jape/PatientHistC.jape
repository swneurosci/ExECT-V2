Phase: PatientHistC
Input: OtherDiag  DiagnosisTriggers Split listPoint Person Drug
Options: control= all


/*  Additional PtHistory These rules annotate events in patient history - type of event with an UMLS CUI, age (precise and as a range), 
date as year/month, and time since the event, as TimePeriod / NumberOfTimePeriods) And this should be the 3rd event within sentence
*/
// All fine - similar to PTHistB 17 rule in other Jape file ( i think anything picked up by that will also be picked up by C2)

// why empty inputs

// Added Person + Drug in input to block running into letter



Macro: SPLIT
(
		{Split} | //this split is at the end of the line (hidden) - could use .kind == external (kind=internal = "." etc...)
		{listPoint}// this is to catch "1./2./3. ...."
)


Rule: PtHistoryC1
Priority: 100

(  
    ({DiagnosisTriggers})
    (SPLIT)[0,4]
	({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC1, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}

Rule: PtHistoryC2
Priority: 100

(  
    ({DiagnosisTriggers})
    (SPLIT)[0,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC2, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}

Rule: PtHistoryC3
Priority: 100

(  
    {DiagnosisTriggers}
    (SPLIT)[0,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
	({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC3, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}


Rule: PtHistoryC4
Priority: 100

(  
    {DiagnosisTriggers}
    (SPLIT)[0,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
	({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC4, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}



Rule: PtHistoryC5
Priority: 100

(  
    {DiagnosisTriggers}
    (SPLIT)[0,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
	({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC5, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}

// A list but with a sentence with other otherdiag :
/*Previous Diagnosis:
Subarachnoid haemorrhage 28 years ago
Hydrocephalus due to subarachnoid haemorrhage with subsequent shunting */
Rule: PtHistoryC6
Priority: 100

(  
    {DiagnosisTriggers}
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})
    ({OtherDiag}):item
  
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC6, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}

// another variation with a list of other diagnosis
Rule: PtHistoryC7
Priority: 100

(  
    {DiagnosisTriggers}
    (SPLIT)[1,4]
    ({OtherDiag})
    (SPLIT)[1,4]
    ({OtherDiag})[1,3]
   (SPLIT)[1,4]
    ({OtherDiag}):item
	
):match  
 -->
:item.PatientHistoryC = {rule = PtHistoryC7, PREF = :item.OtherDiag.PREF, CUI = :item.OtherDiag.CUI,
EC = :item.OtherDiag.EC,  ruleOtherDiag = :item.OtherDiag.rule, 
//Experiencer = :item.OtherDiag.Experiencer, Temporality = :item.OtherDiag.Temporality, 
Certainty = :item.OtherDiag.Certainty, Negation = :item.OtherDiag.Negation,
TimePeriod = :item.OtherDiag.TimePeriod,
NumberOfTimePeriods = :item.OtherDiag.NumberOfTimePeriods,
AgeUnit = :item.OtherDiag.AgeUnit,
Age =:item.OtherDiag.Age,
AgeLower = :item.OtherDiag.AgeLower,
AgeUpper =:item.OtherDiag.AgeUpper,
DayDate =:item.OtherDiag.DayDate,
MonthDate = :item.OtherDiag.MonthDate,
YearDate =:item.OtherDiag.YearDate}