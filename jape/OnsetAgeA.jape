Phase: OnsetAgeA
Input: Lookup Person Token Numeric OnsetPhrase timePeriods time
Options: control=appelt

//experimental rule for those poorly defined ages so rather than adding to Age rules creating a couple of separate rules


	
//Myaclonic seizures started at 10
Rule: onsetAgeA2
Priority: 99

(   
	
	
	({Lookup.majorType == umls , Lookup.Negation == Affirmed , Lookup.Experiencer == Patient , Lookup.minorType == Disease}):item
	{OnsetPhrase}
	({Token.string == at})
	{Numeric}
	{timePeriods}
):match   
 -->
:item.Onset = {rule = onsetAgeA2, OnsetType = "age_episodes_started", 
PREF = :item.Lookup.PREF, CUI = :item.Lookup.CUI, TUI = :item.Lookup.TUI,
//STY = :item.Lookup.STY, 
//Certainty = :item.Lookup.Certainty,
AgeUnit = :timePeriods.time-unit,
Age =:Numeric.value)	



