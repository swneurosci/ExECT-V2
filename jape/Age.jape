Phase: Age
Input: age Numeric YearToMonths timePeriod Lookup2 Person Split timeElapsed Range Sentence YearToMonths Token
Options: control=appelt
//Token is her to exclude picking up PostCode and other word-number combinations//




Rule: Age1a   
Priority: 80

// age of 12 months

(   
	{age}
	{Numeric}
	{timePeriod}
	
 ):match  
 -->
:match.Age = {rule =Age1a, AgeUnit = :match.timePeriod.time-unit,
Age =:match.Numeric.value}

// 12 months old	
Rule: Age1b
Priority: 100

(   
	{Numeric}
    {timePeriod}
	{age}
	
 ):match  
 -->
:match.Age = {rule =Age1b, AgeUnit = :match.timePeriod.time-unit,
Age =:match.Numeric.value}  

//years old 12
Rule: Age1c   
Priority: 80

(   
	{age.AgeUnit ==Year}
	{Numeric}
	
 ):match  
 -->
:match.Age = {rule =Age1c, AgeUnit = :match.age.AgeUnit,
Age =:match.Numeric.value}
 	
/// 12 years old 
Rule: Age1d
Priority: 100

(   
	{Numeric}
	{age.AgeUnit == Year}
	
 ):match  
 -->
:match.Age = {rule =Age1d, AgeUnit = :match.age.AgeUnit,
Age =:match.Numeric.value}  


// during/since age of 12 years/months
Rule: Age_since1
Priority: 99

(   
    {timeElapsed}
	{age.value == aged}
	{Numeric}
	{timePeriod}
		
 ):match  
 -->
:match.Age = {rule =Age_since1, AgeUnit = :match.timePeriod.time-unit,
Age =:match.Numeric.value}  

// during age of 12
Rule: Age_since2
Priority:60

(   
    {timeElapsed.time != Since}
	{age.value == aged}
	{Numeric}
	
 ):match  
 -->
:match.Age = {rule =Age_since2, AgeUnit = "Year",
Age =:match.Numeric.value}  

// he was 12
Rule: Age_since3
Priority:60

(   
    ({timeElapsed})?
	{Person}
	{Token.string == was}
	{Numeric}
	{timePeriod}
	
	
 ):match  
 -->
:match.Age = {rule =Age_since3, AgeUnit = :match.timePeriod.time-unit,
Age =:match.Numeric.value}  


   Rule: Age2
Priority: 90

(   
	{age.value == aged}
	{Numeric}	
	
 ):match  
 -->
:match.Age = {rule =Age2, AgeUnit = "Year",
Age =:match.Numeric.value}  

// at 13 years
Rule: Age_at
Priority: 90

(   
	{Token.string == at}
	{Numeric}	
	{timePeriod}
	
 ):match  
 -->
:match.Age = {rule =Age_at, AgeUnit = :match.timePeriod.time-unit,
Age =:match.Numeric.value}  



/*the first two rule in AgeRange are for the " by the age of x months/years" where only the upper age is givem*/
// NOT SURE numeric.lowerAge works...
 Rule: Age_Range1
Priority: 90

(   
	{age.value == topAge}
	{Numeric}
	{timePeriod}
	
 ):match  
 -->
:match.Age = {rule =Age_Range1, AgeUpper =:match.Numeric.value, AgeLower =:match.Numeric.lowerAge,
AgeUnit =:match.timePeriod.time-unit}

// NOT SURE numeric.lowerAge works...
// before the age of 5
  Rule: Age_Range1b
Priority: 90

(   
	{age.value == topAge}
	{Numeric}	
	
 ):match  
 -->
:match.Age = {rule =Age_Range1b, AgeUpper =:match.Numeric.value, AgeLower =:match.Numeric.lowerAge,
AgeUnit = "Year"}  

// aged 10 to 12

Rule: Age_Range1c
Priority: 90

(   
	{age}
	({Numeric}):a	
	({Token.string == and}|{Token.string == to})
	({Numeric}):b
	{!timePeriod}
 ):match  

 -->
:match.Age = {rule =Age_Range1c, AgeLower =:a.Numeric.value, AgeUpper =:b.Numeric.value, 
AgeUnit = "Year"}  

//when a numeric age is followed by a less precise lookup2 age group i.e. 12 year old teenager / 3 month old baby
//the numeric value of age should be picked up
 Rule: Age_Range2a
Priority: 100

(   
	({timeElapsed})?
	({Numeric}
	{timePeriod}
	{age}
	{Lookup2.minorType == time}):item
	
 ):match  
 -->
:match.Age = {rule =Age_Range2a,Age =:item.Numeric.value, AgeUnit = :match.Lookup2.timeUnit}  


/*lookup2.minorType == time captures age groups e.g. teenager, timeElapsed is not always used in such phrases*/

/* THIS RULE PICKS UP TOO MUCH - NEEDS TO BE MORE SPECIFIC */
// added so As acan be capitalised 
Rule: Age_Range2b
Priority: 90

(   
	({Token.string =~ "[Aa]s"}|{Token.string == "when"}|{Token.string == "was"})
	({Token.string == a})
	{Lookup2.minorType == time}	
	
 ):match  
 -->
:match.Age = {rule =Age_Range2b, AgeLower =:match.Lookup2.lowerAge,
AgeUpper = :match.Lookup2.upperAge, AgeUnit = :match.Lookup2.timeUnit}  



Rule: Age_Range2c
Priority: 90

(   
	({timeElapsed})
	{Lookup2.minorType == time}	
	
 ):match  
 -->
:match.Age = {rule =Age_Range2c, AgeLower =:match.Lookup2.lowerAge,
AgeUpper = :match.Lookup2.upperAge, AgeUnit = :match.Lookup2.timeUnit}  



Rule: Age_Range3
Priority: 90

(   
	{age}
	{Range}	
	({timePeriod})
 ):match  
 -->
:match.Age = {rule =Age_Range3, AgeLower =:match.Range.N1,
AgeUpper = :match.Range.N2, AgeUnit =:match.timePeriod.time-unit} 

 /*between the age of 12 and 30 months - but treated as range*/
 
 /*between the age of 12 month and 30 months - but treated as range*  -  NEED TO BE ADDED */

Rule: Age_Range3a
Priority: 90

(  ({Token.string == between})
	({Token.string == the})?
	{age}
	({Numeric}):N1
	({Token.string == and})
	({Numeric}):N2
	({timePeriod})
 ):match  
 -->
:match.Age = {rule =Age_Range3a, AgeLower =:N1.Numeric.value,
AgeUpper = :N2.Numeric.value, AgeUnit =:match.timePeriod.time-unit} 

Rule: Age_Range3b  /*at the age of 12 and 30 months - but treated as range*/
Priority: 90

(   
	{age}
	({Numeric}):N1
	({Token.string == and})
	({Numeric}):N2
	({timePeriod}):a
 ):match  
 -->
:match.Age = {rule =Age_Range3b, AgeLower =:N1.Numeric.value,
AgeUpper = :N2.Numeric.value, AgeUnit =:a.timePeriod.time-unit} 

// Age Change is for CleaningAgeYears.jape -- these are when different time periods used. Years are converted to months
Rule: Age_Range3c  /*at the age of 12 months and 3 year - but treated as range*/
Priority: 90

(   
	{age}
	({Numeric}):N1
	(({timePeriod.time-unit == "Month"})):b
	({Token.string == and})
	({Numeric}):N2
	({timePeriod.time-unit == "Year"}):a
 ):match  
 -->
:match.Age = {rule =Age_Range3c, AgeLower =:N1.Numeric.value,
AgeUpper = :N2.Numeric.value, AgeUnit =:b.timePeriod.time-unit, AgeChanged = "Upper"} 



Rule: Age_Range3d  /*at the age of 1 year and 30 months - but treated as range*/
Priority: 90

(   
	{age}
	({Numeric}):N1
	(({timePeriod.time-unit == "Year"})):b
	({Token.string == and})
	({Numeric}):N2
	({timePeriod.time-unit == "Month"}):a
 ):match  
 -->
:match.Age = {rule =Age_Range3c, AgeLower =:N1.Numeric.value,
AgeUpper = :N2.Numeric.value, AgeUnit =:b.timePeriod.time-unit,  AgeChanged = "Lower"} 



// at the age of 1 to 2

Rule: Age_Range4
Priority: 100

(   
	({timeElapsed})?
	{age}
	{Range}	
	
 ):match  
 -->
:match.Age = {rule =Age_Range4, AgeLower =:match.Range.N1,
AgeUpper = :match.Range.N2, AgeUnit = Year}  

/// he/she childhood - preset age ranges for specific phrases ("Teenage"/"childhood"/"early twenties"...)

Rule: Age_Range5
Priority: 100

(   
	{Person}
	({Lookup2})?
	{Lookup2.minorType == time}	
	({timePeriod})?
	
 ):match  
 -->
:match.Age = {rule =Age_Range5, AgeLower =:match.Lookup2.lowerAge,
AgeUpper = :match.Lookup2.upperAge, AgeUnit =:match.Lookup2.timeUnit}  


/*when years are converted to months if the upper age is given in months, up to 2 years*/
// 1 year to 18 month

Rule: Age_Range6  
Priority: 100

(   
	{age}
	{YearToMonths}	
	({Token})?
	{Numeric}
	{timePeriod.time-unit == Month}
	
 ):match  
 -->
:match.Age = {rule =Age_Range6, AgeLower =:match.YearToMonths.value, AgeUnit = :match.timePeriod.time-unit,
AgeUpper =:match.Numeric.value} 


// as above but swaped month + years aroun
//   Age from 10 months to 3 years.

Rule: Age_Range6b
Priority: 100

(   
	{age}
	({timeElapsed})? // from
	{Numeric}
	{timePeriod.time-unit == Month}
	({Token})? // to
	{YearToMonths}
 ):match  
 -->
:match.Age = {rule =Age_Range6b, AgeLower =:match.Numeric.value, AgeUnit = :match.timePeriod.time-unit,
AgeUpper =:match.YearToMonths.value} 


// from 6 months to 2 years of age
Rule: Age_Range6c
Priority: 100

(   
	
	({timeElapsed})? // from
	{Numeric}
	{timePeriod.time-unit == Month}
	({Token})? // to
	{YearToMonths}
	{age}
 ):match  
 -->
:match.Age = {rule =Age_Range6c, AgeLower =:match.Numeric.value, AgeUnit = :match.timePeriod.time-unit,
AgeUpper =:match.YearToMonths.value} 
